{
  "name": "mapflow",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven multiresolution work mapping workflow",
  "scripts": {
    "test": "node --test tests/*.mjs",
    "test:oracle": "node tools/benchmark.mjs deterministic-test --level oracle",
    "test:runtime": "node --test tests/test_mapflow.mjs tests/test_workspace.mjs tests/test_board.mjs",
    "test:regression": "node tools/benchmark.mjs deterministic-test --level runtime",
    "benchmark:doctor": "node tools/benchmark.mjs doctor",
    "benchmark:list": "node tools/benchmark.mjs list",
    "benchmark:plan": "node tools/benchmark.mjs regression-plan",
    "demo:evolution": "node tools/evolution-demo.mjs"
  },
  "bin": {
    "mapflow": "./tools/mapflow.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
