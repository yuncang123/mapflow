{
  "schema": "mapflow.benchmark-oracle/v1",
  "case_id": "scope-change-control",
  "case_version": "1.3.4",
  "checkpoints": [
    { "id": "prepared", "description": "空实现仓库已固定且无 Sidecar", "assertions": [
      { "path": "workspace.sidecar_exists", "equals": false }, { "path": "repo.commit_count", "equals": 1 }, { "path": "repo.dirty_paths", "empty": true }
    ] },
    { "id": "original-map-proven", "description": "原目的地已确认，完整候选链整体审阅后成为正式地图", "assertions": [
      { "path": "workspace.map_exists", "equals": true }, { "path": "workspace.briefs_count", "min": 2 },
      { "path": "contract.destination_acceptance", "min": 3 }, { "path": "contract.out_of_scope", "min": 2 }, { "path": "contract.edge_contracts_complete", "equals": true },
      { "path": "proof.structural", "equals": "complete" }, { "path": "proof.reachability", "one_of": ["logical", "conditional"] },
      { "path": "runtime.destination_status", "one_of": ["draft", "confirmed"] }, { "path": "runtime.active_edge", "equals": null },
      { "path": "runtime.active_run", "equals": null }, { "path": "runtime.edge_runs_count", "equals": 0 },
      { "path": "runtime.decisions_count", "equals": 0 }, { "path": "repo.dirty_paths", "empty": true }
    ] },
    { "id": "shared-edge-verified", "description": "共享基础工作已有真实证据可供后续保留", "assertions": [
      { "path": "runtime.evidence_count", "min": 1 }, { "path": "runtime.edge_runs_count", "min": 1 }, { "path": "repo.changed_paths", "nonempty": true },
      { "path": "runtime.decisions_attributed", "equals": true }, { "path": "runtime.runs_follow_authorization_contract", "equals": true },
      { "path": "runtime.evidence_traceable", "equals": true }
    ] },
    { "id": "change-proposed", "description": "范围变化停留在候选层，原正式图和证据仍可见", "assertions": [
      { "path": "workspace.map_exists", "equals": true }, { "path": "runtime.evidence_count", "min": 1 }, { "path": "runtime.replan_count", "equals": 0 },
      { "path": "wayfinding.pending_regression_candidates", "min": 1 }
    ] },
    { "id": "replanned", "description": "人确认后只修订受影响子图并保留先前证据", "assertions": [
      { "path": "runtime.replan_count", "min": 1 }, { "path": "runtime.evidence_count", "min": 1 },
      { "path": "proof.structural", "equals": "complete" }, { "path": "proof.reachability", "one_of": ["logical", "conditional"] }
    ] },
    { "id": "changed-goal-verified", "description": "变更后的 CLI 合同通过隐藏验收", "assertions": [
      { "path": "runtime.evidence_count", "min": 2 }, { "path": "repo.changed_paths", "nonempty": true }
    ], "verifier": "oracle/verify.mjs" },
    { "id": "arrived", "description": "新目的地完成审计且旧目标未冒充交付", "assertions": [
      { "path": "runtime.phase", "equals": "arrived" }, { "path": "runtime.actual_arrival", "equals": "audited" },
      { "path": "runtime.arrival_audit_authorized", "equals": true }, { "path": "runtime.acceptance_complete", "equals": true }
    ], "verifier": "oracle/verify.mjs" }
  ]
}
