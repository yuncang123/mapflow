{
  "schema": "mapflow.benchmark-oracle/v1",
  "case_id": "community-workshop-noncode",
  "case_version": "1.3.4",
  "checkpoints": [
    { "id": "prepared", "description": "非代码工作区处于空白地图基线", "assertions": [
      { "path": "workspace.sidecar_exists", "equals": false }, { "path": "repo.commit_count", "equals": 1 }, { "path": "repo.dirty_paths", "empty": true }
    ] },
    { "id": "surveyed", "description": "非代码事实和未知项已投影且未冒充外部动作", "assertions": [
      { "path": "workspace.sidecar_exists", "equals": true }, { "path": "workspace.wayfinding_exists", "equals": true },
      { "path": "wayfinding.origin_visible", "equals": true }, { "path": "workspace.map_exists", "equals": false }, { "path": "repo.dirty_paths", "empty": true }
    ] },
    { "id": "destination-shaped", "description": "方案包目的地经确认并与活动举办结果分离", "assertions": [
      { "path": "wayfinding.destination_confirmed", "equals": true }, { "path": "wayfinding.open_questions", "max": 1 }, { "path": "summary.edges", "equals": 0 }
    ] },
    { "id": "route-approved", "description": "内容、预算、风险和审批边成为可达正式路线", "assertions": [
      { "path": "workspace.map_exists", "equals": true }, { "path": "workspace.briefs_count", "min": 3 },
      { "path": "contract.destination_acceptance", "min": 4 }, { "path": "contract.destination_invariants", "min": 1 },
      { "path": "contract.out_of_scope", "min": 3 }, { "path": "contract.authorization_rules", "min": 1 }, { "path": "contract.edge_contracts_complete", "equals": true },
      { "path": "proof.structural", "equals": "complete" }, { "path": "proof.reachability", "one_of": ["logical", "conditional"] },
      { "path": "runtime.destination_status", "equals": "approved" }, { "path": "runtime.current_route_approval", "nonempty": true },
      { "path": "runtime.route_approvals_count", "min": 1 }, { "path": "runtime.active_edge", "equals": null },
      { "path": "runtime.active_run", "equals": null }, { "path": "runtime.edge_runs_count", "equals": 0 },
      { "path": "runtime.decisions_count", "equals": 0 }, { "path": "repo.dirty_paths", "empty": true }
    ] },
    { "id": "materials-verified", "description": "非代码产物通过隐藏结构和预算检查并有 Evidence", "assertions": [
      { "path": "repo.changed_paths", "nonempty": true }, { "path": "runtime.evidence_count", "min": 2 }, { "path": "runtime.evidence_traceable", "equals": true }
    ], "verifier": "oracle/verify.mjs" },
    { "id": "authorization-preserved", "description": "Owner 决策被记录但外部动作仍未获授权", "assertions": [
      { "path": "runtime.decisions_count", "min": 1 }, { "path": "runtime.evidence_count", "min": 3 }, { "path": "repo.dirty_paths", "nonempty": true }
    ], "verifier": "oracle/verify.mjs" },
    { "id": "arrived", "description": "方案包目的地完成到达审计而未宣称活动已举办", "assertions": [
      { "path": "runtime.phase", "equals": "arrived" }, { "path": "runtime.actual_arrival", "equals": "audited" },
      { "path": "runtime.arrival_audit_authorized", "equals": true }, { "path": "runtime.acceptance_complete", "equals": true }
    ], "verifier": "oracle/verify.mjs" }
  ]
}
