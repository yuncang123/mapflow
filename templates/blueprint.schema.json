{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mapflow/blueprint.schema.json",
  "title": "Mapflow Blueprint v0.5 (schema 2 compatible extension)",
  "type": "object",
  "required": ["schema_version", "map_id", "destination", "predicates", "initial_state", "assumptions", "invariants", "boundaries", "nodes", "edges", "loops"],
  "properties": {
    "schema_version": { "const": 2 },
    "map_id": { "$ref": "#/$defs/id" },
    "intent": {
      "type": "object",
      "required": ["statement", "status", "open_questions"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "shaped"] },
        "open_questions": { "$ref": "#/$defs/stringList" },
        "legacy_inferred": { "const": true }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["statement", "requires", "invariants", "acceptance"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "requires": { "$ref": "#/$defs/nonEmptyIdList" },
        "invariants": { "$ref": "#/$defs/idList" },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "proves", "proof"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "proves": { "$ref": "#/$defs/nonEmptyIdList" },
              "proof": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fact", "equals", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "fact": { "$ref": "#/$defs/id" },
          "equals": { "$ref": "#/$defs/truthValue" },
          "kind": { "enum": ["state", "authorization", "resource", "progress"] }
        },
        "additionalProperties": false
      }
    },
    "initial_state": {
      "type": "object",
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        }
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "predicate", "source", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "predicate": { "$ref": "#/$defs/id" },
          "source": { "type": "string", "minLength": 1 },
          "status": { "enum": ["accepted", "unverified"] }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "applies_to", "requires"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "applies_to": { "$ref": "#/$defs/nonEmptyIdList" },
          "requires": { "$ref": "#/$defs/nonEmptyIdList" }
        },
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "authorization"],
      "properties": {
        "in_scope": { "$ref": "#/$defs/stringList" },
        "out_of_scope": { "$ref": "#/$defs/stringList" },
        "authorization": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "predicates"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["state", "decision", "fog", "join", "destination"] },
          "label": { "type": "string", "minLength": 1 },
          "predicates": { "$ref": "#/$defs/nonEmptyIdList" },
          "realization_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "brief_ref", "preconditions", "effects", "invariants", "certainty", "evidence_contract", "on_failure"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "brief_ref": { "type": "string", "minLength": 1 },
          "preconditions": { "$ref": "#/$defs/idList" },
          "effects": { "$ref": "#/$defs/nonEmptyIdList" },
          "invariants": { "$ref": "#/$defs/idList" },
          "certainty": { "enum": ["expected", "conditional"] },
          "evidence_contract": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "proves", "required"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "proves": { "$ref": "#/$defs/nonEmptyIdList" },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "on_failure": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": { "enum": ["replan", "branch", "stop"] },
              "to": { "$ref": "#/$defs/id" }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": { "properties": { "action": { "const": "branch" } }, "required": ["action"] },
                "then": { "required": ["to"] },
                "else": { "not": { "required": ["to"] } }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "edges", "progress_predicate", "exit_predicate", "max_iterations"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "edges": { "$ref": "#/$defs/nonEmptyIdList" },
          "progress_predicate": { "$ref": "#/$defs/id" },
          "exit_predicate": { "$ref": "#/$defs/id" },
          "max_iterations": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "submaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "parent_edge", "map_ref", "state_ref", "expected_map_id", "expected_map_digest", "await", "on_parent_close", "exports"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "parent_edge": { "$ref": "#/$defs/id" },
          "map_ref": { "type": "string", "minLength": 1 },
          "state_ref": { "type": "string", "minLength": 1 },
          "expected_map_id": { "$ref": "#/$defs/id" },
          "expected_map_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "await": { "const": "arrival" },
          "on_parent_close": { "enum": ["preserve", "cancel", "invalidate"] },
          "exports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "child_acceptance", "child_predicates", "proves_parent"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "child_acceptance": { "$ref": "#/$defs/id" },
                "child_predicates": { "$ref": "#/$defs/nonEmptyIdList" },
                "proves_parent": { "$ref": "#/$defs/nonEmptyIdList" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^x-" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "truthValue": {
      "enum": ["true", "false", "unknown", "conflict"]
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["git", "document", "command", "receipt", "meeting", "note", "observation", "external"] },
        "ref": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "strength": { "enum": ["asserted", "observed", "corroborated"] },
        "source_event": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "value", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/truthValue" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      },
      "additionalProperties": false
    }
  }
}
