{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mapflow/blueprint.schema.json",
  "title": "Mapflow Blueprint",
  "type": "object",
  "required": ["schema_version", "destination", "current_state", "nodes", "transitions"],
  "properties": {
    "schema_version": { "const": 1 },
    "destination": {
      "type": "object",
      "required": ["statement", "acceptance"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "proof"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "proof": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "current_state": {
      "type": "object",
      "required": ["verified_facts"],
      "properties": {
        "verified_facts": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "probe", "stop_condition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string", "minLength": 1 },
          "probe": { "type": "string", "minLength": 1 },
          "stop_condition": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "boundaries": { "type": "object" },
    "model_policy": {
      "type": "object",
      "properties": {
        "recommended_model": { "type": "string", "minLength": 1 },
        "recommended_reasoning": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "fallback_reasoning": { "type": "string", "minLength": 1 },
        "escalate_when": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
      "required": ["id", "kind", "title", "inputs", "skills", "writes", "preconditions", "expected_state", "verification", "on_failure"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" } },
          "writes": { "type": "array", "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "expected_state": { "type": "string", "minLength": 1 },
          "verification": { "type": "array", "items": { "type": "string" } },
          "rollback": { "type": "string", "minLength": 1 },
          "blocked_by": { "type": "array", "items": { "type": "string" } },
          "slice_kind": { "type": "string", "enum": ["vertical", "decision", "probe", "release"] },
          "model_profile": {
            "type": "object",
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "reasoning": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "test_seam": { "type": "string" },
          "deep_module_notes": { "type": "string" },
          "on_failure": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "when"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "skill_interventions": { "type": "array" },
    "evidence": { "type": "array" },
    "arrival": { "type": "object" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
  },
  "additionalProperties": false
}
